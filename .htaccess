Options -Indexes
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8

# --- Archivos sensibles -------------------------------------------------
<FilesMatch "(^\.env|^\.htaccess|^\.htpasswd|^\.git|^composer\.|^Dockerfile$|^entrypoint\.sh$|\.md$|\.sql$|\.log$|\.bak$)">
  Require all denied
</FilesMatch>

# --- Carpetas internas --------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(database|includes|config|tools|vendor)/ - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^index\.php$ - [L]
</IfModule>

# --- Cabeceras ----------------------------------------------------------
# bootstrap.php ya envia X-Frame-Options, X-Content-Type-Options,
# Referrer-Policy y Permissions-Policy; aqui no se duplican.

# --- Compresion y cache de estaticos ------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
