# Copia este archivo a .env y ajusta los datos de MySQL (XAMPP/WAMP).
DB_HOST=127.0.0.1
DB_NAME=novateam_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

APP_NAME=NovaTeam
APP_ENV=local
SESSION_NAME=NOVATEAMSESS

# Envío de correos. Brevo API (HTTPS, funciona en Railway) o SMTP (local).
BREVO_API_KEY=tu-api-key-de-brevo
SMTP_FROM=novateamrecuperacion@gmail.com
SMTP_FROM_NAME=NovaTeam
# SMTP directo (solo compatible con XAMPP local; Railway bloquea el puerto 587).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=novateamrecuperacion@gmail.com
SMTP_PASS=tu-app-password-de-16-caracteres
